# Copy to .env for local development. Never commit .env.

# Required for sign-in. Create these in the LinkedIn Developer Portal.
# See README for the exact app setup.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must match a redirect URL registered on the LinkedIn app, character for character.
# Local: http://localhost:3000/auth/linkedin/callback
LINKEDIN_CALLBACK_URL=http://localhost:3000/auth/linkedin/callback

# Required in production. At least 32 characters.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Required for colleague research. Official xAI key from https://console.x.ai/
XAI_API_KEY=
# Optional. Defaults to grok-4.7 and the official inference host.
XAI_MODEL=grok-4.7
XAI_BASE_URL=https://api.x.ai/v1

# Optional. Public DuckDuckGo HTML and the Wikipedia API are used with no key.
# If BRAVE_SEARCH_API_KEY is set, Brave Web Search is used as well.
# If it is missing or Brave returns an error, research continues with the no-key sources.
BRAVE_SEARCH_API_KEY=

# Optional. Render and most hosts set PORT themselves.
PORT=3000
NODE_ENV=development
